@model Pedido
@inject ExoLanchonetePedido.Data.ProdutoRepository Produtos
@{ ViewData["Title"] = $"Pedido #{Model.Numero:D3}"; var lista = Produtos.Listar(); }
<div class="detail-head"><div><a class="back" asp-action="Index">← Voltar aos pedidos</a><h2>Pedido #@Model.Numero.ToString("D3")</h2><span class="badge @(Model.Fechado ? "closed" : "open")">@(Model.Fechado ? "Fechado" : "Em aberto")</span></div><div class="total-box"><small>Total</small><strong>R$ @Model.Total.ToString("N2")</strong></div></div>
<div class="detail-grid">
<div class="panel"><div class="panel-head"><div><span class="eyebrow">COMANDA</span><h3>Itens do pedido</h3></div></div>
@if(Model.Itens.Any()){<div class="order-items">@foreach(var i in Model.Itens){<div class="order-item"><span class="mini-food">🍔</span><div><b>@i.Produto.Nome</b><small>@i.Quantidade × R$ @i.Produto.Preco.ToString("N2")</small></div><strong>R$ @i.SubTotal.ToString("N2")</strong></div>}</div>}else{<div class="empty-block">Nenhum item adicionado.</div>}
@if(!Model.Fechado){<form class="add-form" method="post" asp-action="Item" asp-route-numero="@Model.Numero"><label>Adicionar produto<select name="produtoId" required>@foreach(var p in lista){<option value="@p.Id">@p.Nome — R$ @p.Preco.ToString("N2")</option>}</select></label><label>Qtd<input type="number" name="quantidade" min="1" value="1" required></label><button class="primary-btn">Adicionar</button></form>}</div>
<div class="side-stack"><div class="panel"><span class="eyebrow">ENTREGA</span><h3>Entregador</h3><p class="muted">@(Model.Entregador?.Nome ?? "Ainda não definido")</p>@if(!Model.Fechado){<form method="post" asp-action="Entregador" asp-route-numero="@Model.Numero"><input name="nome" placeholder="Nome do entregador" value="@Model.Entregador?.Nome" required><button class="outline-btn full">Salvar entregador</button></form>}</div><div class="panel action-panel"><span class="eyebrow">FINALIZAÇÃO</span><h3>Fechar pedido</h3><p>Ao fechar, o pedido fica registrado como concluído.</p>@if(!Model.Fechado){<form method="post" asp-action="Fechar" asp-route-numero="@Model.Numero"><button class="danger-btn full" @(Model.Itens.Any() ? "" : "disabled")>✓ Finalizar pedido</button></form>}else{<div class="success-message">✓ Pedido finalizado com sucesso</div>}</div></div>
</div>
